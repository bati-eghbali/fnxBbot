# Gemini (https://aistudio.google.com/apikey). One key, or several comma-separated keys:
# GEMINI_API_KEYS=key1,key2
GEMINI_API_KEY=

# Supabase -> Project Settings -> Data API
SUPABASE_URL=
# Supabase -> Project Settings -> API Keys (secret / service_role)
SUPABASE_SERVICE_KEY=
# Supabase -> Connect -> Direct -> Session pooler (URI), with the DB password filled in
SUPABASE_DB_URL=

# Optional overrides
# EMBED_MODEL=gemini-embedding-001
# CHAT_MODEL=gemini-2.5-flash
# CORS_ORIGINS=http://localhost:5173
